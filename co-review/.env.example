# Misc
# Required vs optional: scripts/validate_env.py fails fast before Compose if
# required keys are empty or malformed. Copy this file to .env first.
#
# Production image pull (docker-compose.prod.yml only; ignored by local compose).
# Docker Hub namespace + tag published by scripts/docker-buildx-co-review.sh.
# Example: COREVIEW_REGISTRY=baotq4  COREVIEW_IMAGE_TAG=0.1.2
COREVIEW_REGISTRY=baotq4
COREVIEW_IMAGE_TAG=0.1.2
# Required for core stack: POSTGRES_*, DATABASE_URL,
# GIT_PROVIDER_CREDENTIALS_ENCRYPTION_KEY, SSO_SESSION_SECRET
# (unless SSO_AUTH_DISABLED=true).
# Required with DevLake profile: ENCRYPTION_SECRET.
# Required when any *_EXTERNAL=true: AGENT_EXTERNAL_URL (http(s)).
CO_REVIEW_DASHBOARD_PORT=3000
PR_AGENT_GITHUB_WEBHOOK_RECIEVE_PORT=3002
PR_AGENT_GITLAB_WEBHOOK_RECIEVE_PORT=3003
PR_AGENT_BITBUCKET_WEBHOOK_RECIEVE_PORT=3004
# Bitbucket Server / Data Center: public base URL when using entrypoint bitbucket_server_webhook.
# Example: https://bitbucket.company.com:7990 (no trailing slash). Wired as BITBUCKET_SERVER__URL in compose.
BITBUCKET_SERVER_URL=
# Public URL used to build callback and redirect URLs behind reverse proxies/load balancers.
# Use scheme + host only (no path); NEXT_PUBLIC_BASE_PATH handles the subpath.
# Example: https://netmind.viettel.vn
DASHBOARD_PUBLIC_BASE_URL=
# PR-Agent API URL used by dashboard server-side proxy routes.
# Local docker-compose default typically uses:
#   PR_AGENT_API_URL=http://pr-agent-api:3001
PR_AGENT_API_URL=http://pr-agent-api:3001
# Dashboard URL path prefix when served behind nginx at a subpath (must match next.config basePath).
# Leave empty for local dev at http://localhost:3000/
# Production example (reverse proxy): NEXT_PUBLIC_BASE_PATH=/co-review
# Register SSO redirect_uri as {origin}{NEXT_PUBLIC_BASE_PATH}/auth/sso/callback (e.g. https://netmind.viettel.vn/co-review/auth/sso/callback).
NEXT_PUBLIC_BASE_PATH=
# Dashboard SSO authentication
# Uses OIDC-style wrapper endpoints:
#   {SSO_BASE_URL}/authorize, /token, /userinfo
SSO_BASE_URL=https://netmind.viettel.vn/sso-wrapper
SSO_CLIENT_ID=litellm-test
# Required in production to sign the dashboard session cookie.
# Generate a strong value, for example:
#   openssl rand -base64 48
SSO_SESSION_SECRET=
# Toggle off only for local/dev troubleshooting when SSO is unavailable.
# Applied to both dashboard and pr-agent-api (permission deps bypass when true).
SSO_AUTH_DISABLED=false
# Optional session lifetime (seconds). Default: 28800 (8h)
SSO_SESSION_TTL_SECONDS=28800
# Comma-separated emails that become admin + root on every SSO login (bootstrap).
# Remove an email from this list and have them sign in again to revoke root (→ user + department).
# Admin+root users not in this list are also demoted on SSO login; add the email here to keep root.
# Role and scope for bootstrap / root admins cannot be changed in the Users UI.
# Example: DASHBOARD_BOOTSTRAP_ADMIN_EMAILS=alice@company.com,bob@company.com
DASHBOARD_BOOTSTRAP_ADMIN_EMAILS=
# CR01b Phase 8 — Git provider org scope (false = permission-only / today's list).
# true = path ∩ org_scope_level ceiling, plus org_visibility=global rows.
# Revert anytime: set false (ownership columns remain for re-enable).
ORG_SCOPE_GIT_PROVIDERS=false
# CR01b Phase 9 — LLM provider org scope (independent of Git flag).
# false = permission-only. true = path ∩ org_scope_level ceiling + global rows.
# Revert anytime: set ORG_SCOPE_LLM_PROVIDERS=false (ownership columns remain).
ORG_SCOPE_LLM_PROVIDERS=false
# CR01b Phase 12 — peer visibility grants (default on when unset).
# false = ignore grant rows (home-only); table remains for re-enable.
ORG_SCOPE_PEER_GRANTS=true
# Verbose SSO logs in the Next.js server console (token/userinfo metadata only; never secrets).
# Enabled by default in NODE_ENV=development. Set SSO_DEBUG=true to force on in other envs.
SSO_DEBUG=false

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pr_agent
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Apache DevLake local stack in docker-compose (profile: devlake)
DEVLAKE_VERSION=v1.0.2
DEVLAKE_TZ=UTC
DEVLAKE_UI_HOST_PORT=30090
DEVLAKE_MYSQL_HOST_PORT=3306
DEVLAKE_MYSQL_ROOT_PASSWORD=admin
DEVLAKE_MYSQL_DATABASE=lake
DEVLAKE_MYSQL_USER=merico
DEVLAKE_MYSQL_PASSWORD=merico
# DevLake core DB URL consumed by the devlake container.
DB_URL=mysql://${DEVLAKE_MYSQL_USER}:${DEVLAKE_MYSQL_PASSWORD}@devlake-mysql:3306/${DEVLAKE_MYSQL_DATABASE}?charset=utf8mb4&parseTime=True&loc=UTC
# Required by DevLake to encrypt source credentials/tokens at rest.
# Run: openssl rand -base64 2000 | tr -dc 'A-Z' | fold -w 128 | head -n 1
# then copy the result and paste it here
ENCRYPTION_SECRET=
# Configures grafana links served through devlake-config-ui.
DEVLAKE_GRAFANA_ROOT_URL=http://localhost:${DEVLAKE_UI_HOST_PORT}/grafana
# Grafana admin credentials (used by devlake-grafana container).
DEVLAKE_GRAFANA_ADMIN_USER=admin
DEVLAKE_GRAFANA_ADMIN_PASSWORD=admin

# DevLake API (used by PR-Agent backend integration service)
# Base URL of your DevLake API server (without trailing slash)
# Example: http://localhost:8080
DEVLAKE_API_BASE_URL=http://devlake:8080
# API route prefix exposed by DevLake (no trailing slash).
# Leave unset or empty for the standard DevLake container (paths like /plugins/..., /projects/...).
# Set only when DevLake is behind a reverse proxy that adds a prefix (e.g. /api).
DEVLAKE_API_PREFIX=
# Optional API auth token if your DevLake instance requires authentication.
DEVLAKE_API_TOKEN=
# Optional auth header/scheme override; defaults match Bearer auth.
DEVLAKE_API_AUTH_HEADER=Authorization
DEVLAKE_API_AUTH_SCHEME=Bearer
# Request timeout in seconds for backend->DevLake API calls.
DEVLAKE_API_TIMEOUT_SEC=30
# Set to false only for self-signed/dev TLS endpoints.
DEVLAKE_API_VERIFY_TLS=true

# Dashboard embedding config (recommended):
# 1) Base URL of your Grafana instance (usually via DevLake UI proxy)
# 2) Provider -> dashboard UID map generated by scripts/devlake-setup-grafana-dashboards.sh
#
# Local docker-compose / dev (baked at image build if using NEXT_PUBLIC_*):
#   NEXT_PUBLIC_DEVLAKE_GRAFANA_BASE_URL=http://localhost:30090/grafana
#   NEXT_PUBLIC_DEVLAKE_GRAFANA_DASHBOARD_UID_MAP=github:coreview-github,gitlab:coreview-gitlab,bitbucket:coreview-bitbucket
#
# Staging/production (browser must resolve this URL — NOT localhost):
# Set runtime vars on the dashboard and pr-agent-api containers (no image rebuild required):
#   DEVLAKE_GRAFANA_EMBED_BASE_URL=https://your-public-host/grafana-or-devlake-proxy-path
#   DEVLAKE_GRAFANA_EMBED_DASHBOARD_UID_MAP=github:coreview-github,gitlab:coreview-gitlab
# Use HTTPS if the dashboard is HTTPS (mixed content blocks http iframes).
# Proxy Grafana through nginx on the same site as the dashboard if Grafana is not public.
NEXT_PUBLIC_DEVLAKE_GRAFANA_BASE_URL=
NEXT_PUBLIC_DEVLAKE_GRAFANA_DASHBOARD_UID_MAP=
DEVLAKE_GRAFANA_EMBED_BASE_URL=
DEVLAKE_GRAFANA_EMBED_DASHBOARD_UID_MAP=github:coreview-github,gitlab:coreview-gitlab
# Optional comma-separated hostnames allowed for embed base URL (production hardening).
# Example: DEVLAKE_GRAFANA_EMBED_ALLOWED_HOSTS=netmind.viettel.vn,localhost
DEVLAKE_GRAFANA_EMBED_ALLOWED_HOSTS=

# External agent delegation (GitHub / GitLab / Bitbucket PR-opened events)
# When true, PR/MR-opened events are forwarded to an external agent
# (POST {AGENT_EXTERNAL_URL}/api/v1/external/review) instead of running the
# local PRAgent pipeline. The external agent fetches the diff and publishes
# the review back to the PR itself.
GITHUB_EXTERNAL=false
GITLAB_EXTERNAL=false
BITBUCKET_EXTERNAL=false
# Base URL of the external agent, no trailing slash.
# Inside Docker, localhost refers to the container itself — use
# host.docker.internal (Mac/Win) or a compose service name instead.
# Example: AGENT_EXTERNAL_URL=http://host.docker.internal:3005
AGENT_EXTERNAL_URL=
# Request timeout (seconds) for the delegation POST.
AGENT_EXTERNAL_TIMEOUT_SEC=120
# Optional shared secret, sent as the X-API-Key header.
AGENT_EXTERNAL_SECRET=
# Callback URL that OpenHands can call after posting GitHub comments.
# Example: AGENT_EXTERNAL_CALLBACK_URL=http://host.docker.internal:3001/api/v1/external/review-comments/callback
AGENT_EXTERNAL_CALLBACK_URL=
# Full review payload callback (content, metadata, CodeGraph audit)
# Example: AGENT_EXTERNAL_COMPLETION_CALLBACK_URL=http://host.docker.internal:3001/api/v1/external/review-completed/callback
AGENT_EXTERNAL_COMPLETION_CALLBACK_URL=

# CI trigger for external review (pr-agent-api only).
# When set, POST /api/v1/reviews/external/trigger accepts Authorization: Bearer <token>.
COREVIEW_TRIGGER_TOKEN=
GIT_PROVIDER_CREDENTIALS_ENCRYPTION_KEY=

# Postgres backup (docker-compose service: backup)
# Local disk (default): files land in the backup_data volume at /app/backup
BACKUP_DEST=/app/backup
# S3 instead: BACKUP_DEST=s3://my-bucket/co-review/backups/staging
# age recipient (public key). Generate once:
#   age-keygen -o backup-key.txt
# Put the "public key: age1..." line here; keep the private key for restore only.
BACKUP_ENCRYPTION_KEY=
BACKUP_INTERVAL_HOURS=6
RETENTION_DAYS=14
# Required only when BACKUP_DEST is an s3:// URL
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
# Minio for backup
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Postgres always archives WAL to shared volume wal_archive (compose approach A).
# This flag only gates backup container: false = pg_dump; true = basebackup + wal_shipper.
# Options: true, false
BACKUP_PITR_ENABLED=false
# WAL_ARCHIVE_DIR=/wal_archive
