# z8l-agent backend (app_server) environment template.
#
# Copy this file to `.env` at the repo root and edit as needed:
#     cp .env.example .env
#
# Production image pull (docker-compose.prod.yml). Ignored by local compose.
# OPENHANDS_REGISTRY=baotq4
# OPENHANDS_IMAGE_TAG=0.1.2
#
# The backend auto-loads `.env` on startup via `load_dotenv()` in
# `openhands/app_server/shared.py`, so any value here is injected into the
# process environment before config is read. `.env` is gitignored — never
# commit real secrets. Booleans are read as the exact string `true` unless
# noted otherwise. Everything below is OPTIONAL; the app runs with no `.env`.
#
# NOTE: For the V1 web app, your LLM model + API key are configured in the
# Settings UI, not here. The frontend has its own template: frontend/.env.sample.

# ──────────────────────────────────────────────────────────────────────────
# Feature flags  (read in app_server/web_client/default_web_client_config_injector.py)
# Each is True only when set to exactly `true`.
# ──────────────────────────────────────────────────────────────────────────

# Enable the pluggable agent-harness (ACP) selector in Settings → Agent.
# This surfaces the z8l-agent/ACP toggle, the harness preset dropdown
# (Claude Code / Codex / Gemini CLI / Custom / …), and the model field.
ENABLE_ACP=true

# Other UI feature flags (defaults shown).
# ENABLE_BILLING=false
# HIDE_LLM_SETTINGS=false
# ENABLE_JIRA=false
# ENABLE_JIRA_DC=false
# ENABLE_LINEAR=false
# HIDE_USERS_PAGE=false
# HIDE_BILLING_PAGE=false
# HIDE_INTEGRATIONS_PAGE=false
# OH_ENABLE_ONBOARDING=false

# ──────────────────────────────────────────────────────────────────────────
# Core server / runtime
# ──────────────────────────────────────────────────────────────────────────

# V1 app server routes are enabled unless this is exactly "0".
# ENABLE_V1=1

# Runtime/sandbox backend the agent runs in: local | process | remote
# (unset uses the Docker sandbox). For "z8l-agent on z8l-agent" use local.
# RUNTIME=local

# Skip building/pulling the Docker sandbox image during `make build`
# (handy when RUNTIME=local). Consumed by the Makefile.
# INSTALL_DOCKER=0

# Serve the built frontend from the backend process.
# SERVE_FRONTEND=false

# Comma-separated CORS origins permitted by the backend.
# PERMITTED_CORS_ORIGINS=http://localhost:3001

# Public web host used when generating callback/webhook URLs.
# OH_WEB_HOST=
# WEB_HOST=

# ──────────────────────────────────────────────────────────────────────────
# Logging / debugging
# ──────────────────────────────────────────────────────────────────────────

# DEBUG=false             # verbose logging (also LLM prompt/response logs)
# DEBUG_LLM=false
# DEBUG_RUNTIME=false
# LOG_LEVEL=INFO
# LOG_TO_FILE=false
# LOG_ALL_EVENTS=false
# LOG_JSON=false

# SQLAlchemy SELECT/BEGIN query text (independent of LOG_LEVEL); true to enable
LOG_SQL=false

# ──────────────────────────────────────────────────────────────────────────
# LLM / provider routing (V1 keys/models live in the Settings UI)
# ──────────────────────────────────────────────────────────────────────────

# LLM_BASE_URL=               # custom OpenAI-compatible / proxy base URL
# OLLAMA_BASE_URL=            # e.g. http://localhost:11434
# OPENHANDS_PROVIDER_BASE_URL=
# Web search tool key (one of):
# SEARCH_API_KEY=
# TAVILY_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Sandbox / agent-server image
# ──────────────────────────────────────────────────────────────────────────

# Extra host paths mounted into the sandbox (host:container[:mode], comma-sep).
# SANDBOX_VOLUMES=
# Seconds the app waits for the agent-server container to respond to /health
# before declaring the sandbox in ERROR state. Default in code is 15s; raise this
# on slower hosts where the agent-server takes longer to initialize (e.g. 60).
SANDBOX_STARTUP_GRACE_SECONDS=60
# SANDBOX_KVM_ENABLED=false
# Remote-runtime mode only:
# SANDBOX_API_KEY=
# SANDBOX_REMOTE_RUNTIME_API_URL=
# SANDBOX_CONTAINER_URL_PATTERN=
SANDBOX_HOST_PORT=3005
# Override the agent-server (harness host) image:
AGENT_SERVER_IMAGE_REPOSITORY=ghcr.io/oadtq/agent-server
AGENT_SERVER_IMAGE_TAG=1.28.0-z8l.2-python
# AGENT_SERVER_USE_HOST_NETWORK=false

# ──────────────────────────────────────────────────────────────────────────
# Storage / persistence
# ──────────────────────────────────────────────────────────────────────────

# FILE_STORE=local            # local | s3 | google_cloud | memory
# FILE_STORE_PATH=
# OH_PERSISTENCE_DIR=

# ──────────────────────────────────────────────────────────────────────────
# Security / session
# ──────────────────────────────────────────────────────────────────────────

# Static key required as the X-Session-API-Key header on requests. Leave unset
# for local dev — in some sandboxes an inherited value makes /api/v1/settings
# return 401 in the browser; unset it then.
# SESSION_API_KEY=
# JWT_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# Advanced / enterprise (SaaS deployments only — usually leave unset).
# DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASS / DB_SSL_MODE
# AWS_* / GCP_* / GOOGLE_CLOUD_BUCKET_NAME    (object storage)
# GITHUB_APP_* / GITLAB_APP_* / BITBUCKET_* / AZURE_DEVOPS_CLIENT_ID  (git OAuth)
# SLACK_CLIENT_ID / SLACK_CLIENT_SECRET / SLACK_SIGNING_SECRET
# JIRA_DC_* / FORGEJO_* / ENABLE_ENTERPRISE_SSO / POSTHOG_CLIENT_KEY
# ──────────────────────────────────────────────────────────────────────────


# ──────────────────────────────────────────────────────────────────────────
# co-review integration (external review from PR-Agent)
# ──────────────────────────────────────────────────────────────────────────

# Wall-clock timeout for external review jobs in seconds (default in code: 1800).
# EXTERNAL_REVIEW_JOB_TIMEOUT_SECONDS=1800

# this one is for the retry callback to co-review to update the status of the job
# COREVIEW_WEBHOOK_PROCESSING_CALLBACK_URL=http://pr-agent-api:3001/api/webhooks/processing-callback

# Skip startup env validation (local debugging only).
# OH_SKIP_ENV_VALIDATION=true
